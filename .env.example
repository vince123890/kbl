# Salin ke .env.local lalu isi dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# anon key atau publishable key (aman dipakai di browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role / secret key: HANYA server, jangan diberi awalan NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# URL publik aplikasi, dipakai pada link reset password
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hanya untuk `npm run seed:admin` (membuat SYS_ADMIN pertama)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin Sistem

# Kontak di landing page (opsional). Kosong = bagian kontak tidak ditampilkan.
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# --- Job terjadwal dan notifikasi (opsional kecuali CRON_SECRET bila memakai /api/jobs/run)
# Rahasia pemanggil /api/jobs/run (Vercel Cron mengirimnya otomatis sebagai Bearer token)
CRON_SECRET=
# Web Push: buat dengan `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# WhatsApp / SMS / Email: webhook penyedia pilihan Anda. Menerima POST JSON {channel,to,title,body,link,id}
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
