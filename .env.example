# Salin ke .env.local lalu isi dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# anon key atau publishable key (aman dipakai di browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role / secret key: HANYA server, jangan diberi awalan NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# URL publik aplikasi, dipakai pada link reset password
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hanya untuk `npm run seed:admin` (membuat SYS_ADMIN pertama)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin Sistem
